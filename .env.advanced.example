# Optional additions to .env.example; not a replacement for the base template.
# Add these assignments ONCE to your existing local .env; keep its credentials.
# Stack/BMW settings belong in .env; SMA application settings stay in smab.env.
# See docs/bridges.advanced.md before enabling either bridge.

# Load both Compose files for ordinary docker compose commands on Linux.
# Keep any existing custom Compose files in the list, with the base file first.
COMPOSE_FILE=docker-compose.yml:docker-compose.advanced.yml

# Edit the EXISTING COMPOSE_PROFILES assignment in .env to opt in.
# Keep mqtt,influxdb,grafana for the unchanged default (both bridges disabled).
# Add sma and/or bmw only after configuring that bridge:
# COMPOSE_PROFILES=mqtt,influxdb,grafana,sma,bmw
# Profiles do not create devices, Items or authentication tokens.

# SMA MQTT Bridge: published image tag; use a tested release tag when available.
SMAB_BRIDGE_VERSION=latest
# Compose-only ENV path and container user. Keep an existing smab.env unchanged.
SMAB_ENV_FILE=./smab.env
SMAB_UID=10001
SMAB_GID=10001
# MQTT credentials, device settings, logging and command gates go in smab.env.
# See the upstream smab.example.env; do not duplicate those settings here.

# BMW CarData MQTT Bridge: published image tag.
BMB_VERSION=latest
BMB_LOG_LEVEL=info
# Obtain both IDs from BMW; these are not generated with OpenSSL.
# Compose requires these declarations even when the BMW profile is disabled.
# Leave the placeholders only for an unused profile; replace them before login.
BMB_BMW_CLIENT_ID=CHANGE_ME_BMW_CLIENT_ID
BMB_BMW_GCID=CHANGE_ME_BMW_GCID
BMB_BMW_HOST=customer.streaming-cardata.bmwgroup.com
BMB_BMW_PORT=9000
BMB_BMW_STATUS_STABLE_DELAY=5
# BMW uses app-nw. With the local mqtt profile, use the service name and the
# CONTAINER port, regardless of the broker's published host port.
# With an external broker, replace the hostname and port accordingly.
BMB_MQTT_LOCAL_HOST=mosquitto
BMB_MQTT_LOCAL_PORT=8883
BMB_MQTT_LOCAL_USER=bmw-bridge
# Create this account in your broker; generate with: openssl rand -hex 32
BMB_MQTT_LOCAL_PASSWORD=CHANGE_ME_BMW_MQTT_PASSWORD
BMB_MQTT_LOCAL_PREFIX=bmw/
# A unique MQTT client ID for this instance; use different IDs for extra instances.
BMB_MQTT_LOCAL_CLIENT_ID=bmw-mqtt-bridge
# TLS encrypts traffic; certificate and hostname verification are disabled.
BMB_MQTT_LOCAL_TLS=true
BMB_MQTT_LOCAL_TLS_VERIFY=false
# Set to 1 for Homie discovery; it requires openHAB MQTT setup and Item links.
BMB_MQTT_HOMIE=0
BMB_MQTT_RAW_TOPICS=1
BMB_MQTT_SPLIT_TOPICS=0
# RAW/split retention is independent of Homie descriptions and values.
BMB_MQTT_RETAIN=0
BMB_HEALTH_MQTT_DISCONNECT_TIMEOUT=120
