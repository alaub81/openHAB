# Configuration template: copy to .env and configure the services you enable.
# Generate each password/token separately; do not reuse the same value across services.
# Existing installations must retain their local .env and working credentials.

# Optional services: mqtt, influxdb, grafana (Grafana + PostgreSQL + renderer).
# All optional services are enabled by default. Remove profiles you do not need.
# Set COMPOSE_PROFILES= to start only openHAB.
COMPOSE_PROFILES=mqtt,influxdb,grafana

# Config File for openHAB Application

# Docker Compose Project Name
# max length 11 characters
PROJECT_NAME=openhab5

# Port Configuration openHab
OPENHAB_VERSION=5.2.3
OPENHAB_HTTP_PORT=8080
OPENHAB_HTTPS_PORT=8443

# InfluxDB Configuration
INFLUXDB_VERSION=2.9-alpine
INFLUXDB_HTTP_PORT=8086
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=admin
# Initial setup only: generate a unique password with: openssl rand -hex 32
INFLUXDB_INIT_PASSWORD=CHANGE_ME_INFLUXDB_PASSWORD
INFLUXDB_INIT_ORG=myorg
INFLUXDB_INIT_BUCKET=openhab_db
# Initial setup only: generate a separate admin token with: openssl rand -hex 32
INFLUXDB_INIT_ADMIN_TOKEN=CHANGE_ME_INFLUXDB_ADMIN_TOKEN
INFLUXD_LOG_LEVEL=warn

# Port Configuration Grafana
GRAFANA_VERSION=13.2
GRAFANA_HTTP_PORT=3000
## Set the Server URL, so links in Alert Mails are not related to localhost.
GRAFANA_SERVER_ROOT_URL=http://YOURSERVERNAME:3000
## Grafana Mailing
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=YOURMAILSERVER:465
GRAFANA_SMTP_USER=YOURSMTPUSER
# Use the password or app password issued by your SMTP provider.
# For a mail account you manage, generate a password with: openssl rand -hex 32
# Set that password on the mail server as well; changing this value alone does not change the account.
GRAFANA_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
GRAFANA_SMTP_FROM_ADDRESS=MAIL@FROMADRESS.TLD

# Grafana Renderer Authentication
# Shared only by Grafana and its renderer; generate with: openssl rand -hex 32
GRAFANA_RENDERING_RENDERER_TOKEN=CHANGE_ME_GRAFANA_RENDERER_TOKEN

# Postgres Configuration
POSTGRES_VERSION=18-alpine
# Initial database setup only: generate a unique password with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_USER=grafana
POSTGRES_DB=grafanadb

# Port Configuration Mosquitto
MOSQUITTO_VERSION=2
MOSQUITTO_MQTT_PORT=1883
MOSQUITTO_MQTTS_PORT=8883

# Timezone
TZ=Europe/Berlin
