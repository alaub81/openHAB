# Inactive file-based template: .example files are not loaded by openHAB.
# All broker/device UIDs, MQTT topics and schedule rule IDs are synthetic.
# Replace them with your own; preserve your real UID when migrating existing links.
# Configuration is maintained in this file after migration.
version: 1
things:
  mqtt:topic:examplebroker:exampledevice:
    bridge: mqtt:broker:examplebroker
    label: Walldisplay Badezimmer MQTT
    location: Shelly MQTT
    config:
      payloadNotAvailable: 'false'
      availabilityTopic: shelly/example-wall-display/online
      payloadAvailable: 'true'
    channels:
      relay#output:
        type: switch
        label: Betrieb
        description: Betrieb (on/off)
        config:
          stateTopic: shelly/example-wall-display/status/switch:0
          transformationPattern:
          - JSONPATH:$.output
          'off': 'false'
          'on': 'true'
      thermostat#switch:
        type: switch
        label: Thermostat Betrieb
        description: Thermostat Betrieb (on/off)
        config:
          commandTopic: shelly/example-wall-display/rpc
          formatBeforePublish: '{"id":1,"src":"shelly/example-wall-display/oh","method":"Thermostat.SetConfig","params":{"id":0,"config":{"enable":%s}}}'
          stateTopic: shelly/example-wall-display/status/thermostat:0
          transformationPattern:
          - JSONPATH:$.enable
          'off': 'false'
          'on': 'true'
      thermostat#setpoint:
        type: number
        label: Solltemperatur
        description: Solltemperatur in °C
        config:
          unit: "°C"
          min: 18
          formatBeforePublish: '{"id": 1,"src": "shelly/example-wall-display/oh","method":
            "Thermostat.SetConfig","params": {"id": 0,"config": {"target_C": %f}}}'
          max: 30
          commandTopic: shelly/example-wall-display/rpc
          step: 0.1
          stateTopic: shelly/example-wall-display/status/thermostat:0
          transformationPattern:
          - JSONPATH:$.target_C
      thermostat#hysterese:
        type: number
        label: Hysterese
        description: Solltemperatur in °C
        config:
          commandTopic: shelly/example-wall-display/rpc
          unit: "°C"
          step: 0.1
          min: 0
          formatBeforePublish: '{"id": 1,"src": "shelly/example-wall-display/oh","method":
            "Thermostat.SetConfig","params": {"id": 0,"config": {"hysteresis": %f}}}'
          max: 2
      thermostat#schedule:
        type: switch
        label: Zeitplan
        description: Zeitplan (on/off)
        config:
          commandTopic: shelly/example-wall-display/rpc
          formatBeforePublish: '{"id":1,"src":"shelly/example-wall-display/oh","method":"Thermostat.Schedule.SetConfig","params":{"id":0,"config":{"enable":%s}}}'
          stateTopic: shelly/example-wall-display/status/thermostat:0
          transformationPattern:
          - JSONPATH:$.schedules.enable
          'off': 'false'
          'on': 'true'
      thermostat#scheduleprofile:
        type: number
        label: Zeitplan Profil
        description: Zeitplan Profil
        config:
          commandTopic: shelly/example-wall-display/rpc
          formatBeforePublish: '{"id":1,"src":"shelly/example-wall-display/oh","method":"Thermostat.Schedule.SetConfig","params":{"id":0,"config":{"profile_id":%.0f}}}'
          stateTopic: shelly/example-wall-display/status/thermostat:0
          transformationPattern:
          - JSONPATH:$.schedules.profile_id
      thermostat#night_temperature:
        type: number
        label: Nacht Temperatur
        description: Nachttemperatur in °C
        config:
          commandTopic: shelly/example-wall-display/rpc
          unit: "°C"
          step: 0.5
          min: 18
          formatBeforePublish: '{"id": 10,"src": "shelly/example-wall-display/oh","method":
            "Thermostat.Schedule.ChangeRule","params": {"id": 0, "config": {"rule_id":
            1001,"target_C": %f}}}'
          max: 30
      thermostat#booster_temperature:
        type: number
        label: Booster Temperatur
        description: Booster Temperatur in °C
        config:
          commandTopic: shelly/example-wall-display/rpc
          unit: "°C"
          step: 0.5
          min: 18
          formatBeforePublish: '{"id": 10,"src": "shelly/example-wall-display/oh","method":
            "Thermostat.Schedule.ChangeRule","params": {"id": 0, "config": {"rule_id":
            1002,"target_C": %f}}}'
          max: 30
      thermostat#sggreen_temperature:
        type: number
        label: SG Green Temperatur
        description: SG-Green Temperatur in °C
        config:
          commandTopic: shelly/example-wall-display/rpc
          unit: "°C"
          step: 0.5
          min: 18
          formatBeforePublish: '{"id": 10,"src": "shelly/example-wall-display/oh","method":
            "Thermostat.Schedule.ChangeRule","params": {"id": 0, "config": {"rule_id":
            1003,"target_C": %f}}}'
          max: 30
      thermostat#absence_temperature:
        type: number
        label: Abwesenheit Temperatur
        description: Abwesenheit Temperatur in °C
        config:
          commandTopic: shelly/example-wall-display/rpc
          unit: "°C"
          step: 0.5
          min: 18
          formatBeforePublish: '{"id": 10,"src": "shelly/example-wall-display/oh","method":
            "Thermostat.Schedule.ChangeRule","params": {"id": 0, "config": {"rule_id":
            1004,"target_C": %f}}}'
          max: 30
      thermostat#windowopen_temperature:
        type: number
        label: Fenster offen Temperatur
        description: Fenster offen Temperatur in °C
        config:
          commandTopic: shelly/example-wall-display/rpc
          unit: "°C"
          step: 0.5
          min: 18
          formatBeforePublish: '{"id": 10,"src": "shelly/example-wall-display/oh","method":
            "Thermostat.Schedule.ChangeRule","params": {"id": 0, "config": {"rule_id":
            1005,"target_C": %f}}}'
          max: 30
      thermostat#basistemp:
        type: number
        label: Basis-Solltemperatur
        description: Manuelle Temperatur ohne Profil
        config:
          stateTopic: shelly/example-wall-display/oh/rpc
          transformationPattern:
          - JSONPATH:$.result.target_C
      sensor#temperature:
        type: number
        label: Temperatur
        description: Temperatur in °C
        config:
          stateTopic: shelly/example-wall-display/status/temperature:0
          transformationPattern:
          - JSONPATH:$.tC
          unit: "°C"
      sensor#humidity:
        type: number
        label: Luftfeuchtigkeit
        description: Luftfeuchtigkeit in %
        config:
          stateTopic: shelly/example-wall-display/status/humidity:0
          transformationPattern:
          - JSONPATH:$.rh
          unit: "%"
      sensor#illuminance:
        type: number
        label: Beleuchtungsstärke
        description: Beleuchtungsstärke in Lux
        config:
          stateTopic: shelly/example-wall-display/status/illuminance:0
          transformationPattern:
          - JSONPATH:$.lux
          unit: lx
      sensor#battery:
        type: number
        label: Batterieladung
        description: Batterieladung in %
        config:
          stateTopic: shelly/example-wall-display/status/devicepower:1
          transformationPattern:
          - JSONPATH:$.battery.percent
          unit: "%"
