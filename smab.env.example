# Example for this repository's Advanced Compose setup.
# Copy to smab.env, keep an existing private file, and protect it with chmod 600.
# Devices remain enabled as a complete setup example. Replace every device host,
# profile, serial, identity and credential before starting; disable absent devices.
# Device writes are enabled in this example. Review command behavior before use.
# See the upstream smab.example.env for all options.

# MQTT over TLS on the shared Compose network; certificate verification is disabled.
# This login is PUBLIC: replace mosquitto-mqtt in both the broker and smab.env.
# Traffic is encrypted, but the broker certificate and hostname are not verified.
SMAB_MQTT_HOST=mosquitto
SMAB_MQTT_PORT=8883
SMAB_MQTT_USERNAME=mosquitto
SMAB_MQTT_PASSWORD=mosquitto-mqtt
SMAB_MQTT_TLS=true
SMAB_MQTT_TLS_VERIFY=false

# Explicit write gates for the local charger and portal controls.
# Set these to false if you want read-only operation.
SMAB_COMMANDS_ENABLED=true
SMAB_ECHARGER_COMMANDS_ENABLED=true
SMAB_PORTAL_COMMANDS_ENABLED=true
SMAB_PLANT_ENABLED=true

# Three model-specific examples, with synthetic addresses and serial selectors.
# Verify each actual model and firmware against its profile before enabling reads.
SMAB_INVERTER1_ENABLED=true
SMAB_INVERTER1_HOST=192.0.2.20
SMAB_INVERTER1_PROFILE=sma-stp8-0-3av-40
SMAB_INVERTER1_EXPECTED_SERIAL=1234567891
SMAB_INVERTER1_HOMIE_ID=sma-inv1-roof
SMAB_INVERTER2_ENABLED=true
SMAB_INVERTER2_HOST=192.0.2.30
SMAB_INVERTER2_PROFILE=sma-sbs3-7-10
SMAB_INVERTER2_EXPECTED_SERIAL=1234567892
SMAB_INVERTER2_HOMIE_ID=sma-inv2-battery
SMAB_INVERTER3_ENABLED=true
SMAB_INVERTER3_HOST=192.0.2.40
SMAB_INVERTER3_PROFILE=sma-sb4-0-1av-41
SMAB_INVERTER3_EXPECTED_SERIAL=1234567893
SMAB_INVERTER3_HOMIE_ID=sma-inv3-carport

# Sunny Home Manager 2.0: Modbus TCP only; no multicast or supplemental UDP.
SMAB_HOME_MANAGER_ENABLED=true
SMAB_HOME_MANAGER_TRANSPORT=modbus-tcp
SMAB_HOME_MANAGER_HOST=192.0.2.10
SMAB_HOME_MANAGER_SERIAL=1234567890
SMAB_HOME_MANAGER_MODBUS_PORT=502
SMAB_HOME_MANAGER_UDP_PHASES_ENABLED=false
SMAB_HOME_MANAGER_MULTICAST_ENABLED=false

# Local eCharger API and SEMP, with separate example credentials and identities.
# Install its trusted public certificate/CA under the mounted configuration directory.
SMAB_ECHARGER_ENABLED=true
SMAB_ECHARGER_HOST=192.0.2.50
SMAB_ECHARGER_USERNAME=installer-example
SMAB_ECHARGER_PASSWORD=CHANGE_ME_ECHARGER_PASSWORD
SMAB_ECHARGER_TLS_VERIFY=true
SMAB_ECHARGER_TLS_CA_FILE=/data/sma-mqtt-bridge/config/certificates/sma-echarger.crt
SMAB_ECHARGER_TLS_SERVER_NAME=SMA1234567894.local
SMAB_ECHARGER_EXPECTED_SERIAL=1234567894
SMAB_ECHARGER_SEMP_ENABLED=true
SMAB_ECHARGER_SEMP_DEVICE_ID=0-000015BB-001234567894-00
SMAB_ECHARGER_TIMESTAMP_DIAGNOSTICS_ENABLED=true

# Optional direct BYD diagnostics; disable if not present.
SMAB_BYD_ENABLED=true
SMAB_BYD_HOST=192.0.2.31

# Optional ennexOS portal account, separate from the local charger account.
SMAB_PORTAL_ENABLED=true
SMAB_PORTAL_USERNAME=user@example.invalid
SMAB_PORTAL_PASSWORD=CHANGE_ME_PORTAL_PASSWORD
SMAB_PORTAL_PLANT_ID=12345678
SMAB_PORTAL_DEVICE_ID=87654321
SMAB_LANGUAGE=de
